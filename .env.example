# Firebase (Firestore) — copie este arquivo para ".env" e preencha com os dados do seu projeto.
# Console do Firebase > Configurações do projeto > Seus apps > App da Web > "firebaseConfig".
# Sem estes valores o app continua funcionando, mas salva os dados só no aparelho (banco local).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
